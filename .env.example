APP_NAME="Legal AI Assistant"
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=["http://localhost:8501","http://localhost:3000"]

MONGODB_URI=mongodb://mongo:27017
MONGODB_DATABASE=legal_ai_assistant
REDIS_URL=redis://redis:6379/0

# PostgreSQL stores user-owned transactional data. These development values
# are consumed by docker-compose.yml; use a secret manager and sslmode=require
# in staging/production.
POSTGRES_DB=legal_ai
POSTGRES_USER=legal_ai
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_POSTGRES_PASSWORD
POSTGRESQL_ENABLED=true
POSTGRESQL_URL=postgresql://legal_ai:REPLACE_WITH_A_STRONG_POSTGRES_PASSWORD@postgres:5432/legal_ai

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required (32+ chars, not a placeholder) whenever ENVIRONMENT=production or staging -- see app/core/config.py.
JWT_SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_SECRET_MIN_32_CHARS
# Required in staging/production. Inject from a secret manager; do not commit a real value.
SECRETS_ENCRYPTION_KEY=REPLACE_WITH_A_SECRET_MANAGER_VALUE_MIN_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

LLM_PROVIDER=groq
# Ordered backups used after the primary fails, for example: gemini,ollama
LLM_FALLBACK_PROVIDERS=
LLM_MAX_RETRY_ATTEMPTS=3
LLM_RETRY_BACKOFF_SECONDS=0.75
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_MAX_TOKENS=4096
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
LLM_TIMEOUT=120
# The backend budget must remain at least 5 seconds below the client timeout.
CLIENT_REQUEST_TIMEOUT_SECONDS=180
CHAT_REQUEST_BUDGET_SECONDS=150
LLM_MAX_TOKENS=4096
TEMPERATURE=0.2
TOP_P=0.9
TOP_K=40

EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_VERSION=2026-08-03
EMBEDDING_DEVICE=
EMBEDDING_DIMENSIONS=1024
VECTOR_STORE_PROVIDER=mongodb
VECTOR_SEARCH_BACKEND=atlas
# Fallback in-process scan cap when VECTOR_SEARCH_BACKEND=local or Atlas errors out.
LOCAL_VECTOR_SCAN_LIMIT=20000
VECTOR_SCHEMA_VERSION=v1
MONGODB_VECTOR_INDEX=legal_chunks_vector_index
# Off by default -- an optional cross-encoder relevance signal blended into
# LegalReranker's existing hand-tuned heuristics (see app/rag/reranker.py).
# Needs a one-time HuggingFace model download on first use.
USE_NEURAL_RERANKER=false
NEURAL_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
NEURAL_RERANKER_WEIGHT=0.25
PROMPT_VERSION=v1
MODEL_VERSION=v1
INDEXING_BATCH_SIZE=32
MIN_OCR_QUALITY_SCORE=0.55
MIN_METADATA_QUALITY_SCORE=0.45
OCR_ENABLED=true
OCR_LANGUAGE=eng+hin
# Handwritten/layout extraction uses GEMINI_API_KEY independently of the chat model.
HANDWRITING_OCR_MODEL=gemini-3.6-flash
HANDWRITING_OCR_MAX_PAGES=20
HANDWRITING_OCR_TIMEOUT_SECONDS=120
HANDWRITING_OCR_DOCUMENT_TIMEOUT_SECONDS=600

MAX_UPLOAD_MB=25
UPLOAD_STORAGE_DIR=./storage/uploads
KNOWLEDGE_BASE_DIR=./storage/knowledge_base
KB_AUTOMATION_ENABLED=false
KB_AUTOMATION_INTERVAL_MINUTES=60
KB_AUTOMATION_MANIFEST=./config/kb_sources.json
KB_AUTOMATION_MAX_DOWNLOAD_MB=25
KB_AUTOMATION_MAX_ATTEMPTS=4
KB_AUTOMATION_SOURCE_REFRESH_HOURS=24
KB_AUTOMATION_ADAPTER_ALLOWLIST=
# When enabled, a chat answer that comes back "out of KB" queues its likely
# Act for an automatic fetch+verify+index attempt in the background (never
# blocks the chat response). Reaches out to the internet based on live,
# unauthenticated user input -- opt in deliberately. See
# app/services/kb_gap_autofetch.py.
KB_GAP_AUTOFETCH_ENABLED=false
KB_GAP_AUTOFETCH_INTERVAL_MINUTES=15
KB_GAP_AUTOFETCH_MAX_ATTEMPTS=3
# When enabled, a legal question that clears zero verified Knowledge Base
# chunks may be answered from the LLM's general knowledge instead of the bare
# refusal -- clearly labeled "General Legal Knowledge" with an unverified-
# answer disclaimer, never for a question needing a specific provision or the
# current/latest law, and discarded if the model's answer still contains a
# citation-shaped fragment or a self-rated low confidence. See
# app/core/gk_fallback.py.
GENERAL_KNOWLEDGE_FALLBACK_ENABLED=false
KB_PRODUCTION_REQUIRED_JURISDICTIONS=UP,DL,MH,GA,DH
KB_RELEASE_EVALUATION_MAX_AGE_HOURS=168
KB_RELEASE_MIN_EVALUATION_SCORE=0.95
KB_REVIEW_SLA_HOURS=72
KB_CANARY_RECHECK_HOURS=24
# Required and fail-closed in staging/production. Install ClamAV in the worker image.
KB_MALWARE_SCAN_COMMAND=clamscan
SESSION_TTL_SECONDS=86400
RATE_LIMIT_PER_MINUTE=60
# IP(s) of a reverse proxy/load balancer directly in front of this API, if
# any. Only a peer in this list has its X-Forwarded-For header trusted for
# rate-limiting; leave empty (default) when the API is exposed directly.
TRUSTED_PROXY_IPS=[]
LOG_LEVEL=INFO
SENTRY_DSN=
# e.g. http://otel-collector:4318/v1/traces (OTLP/HTTP). Empty (default) means
# tracing spans are created locally but exported nowhere -- see
# app/observability/tracing.py.
OTEL_EXPORTER_OTLP_ENDPOINT=
BACKGROUND_JOB_POLL_SECONDS=1
BACKUP_DIR=./storage/backups
# How many days the two analytics collections that carry user message text
# (query_logs, intent_events) are retained. Applied at startup as a MongoDB TTL
# index. 0 = keep forever (the default). Personal identifiers are redacted from
# these records regardless (see app/utils/pii.py); this bounds how long even
# the redacted record survives. Does NOT affect the user's own chat history,
# which they delete themselves via DELETE /session.
ANALYTICS_RETENTION_DAYS=0

DRAFT_OUTPUT_DIR=./storage/drafts
DRAFT_MAX_FACTS_CHARS=6000
# Leave empty to auto-detect C:\Windows\Fonts\Nirmala.ttc on Windows dev
# machines. In Docker/Linux, set to a Devanagari-capable TTF, e.g. the path
# installed by the `fonts-noto-core` apt package added to the Dockerfile:
# /usr/share/fonts/truetype/noto/NotoSansDevanagari-Regular.ttf
PDF_UNICODE_FONT_PATH=
